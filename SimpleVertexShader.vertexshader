#version 330 core

// Input vertex data, different for all executions of this shader.
layout(location = 0) in vec3 vertexPos; 

// Add uniform variable for the transform matrix 
uniform mat4 transform;

// 1. ADDED: Declare the output variable to send to the Fragment Shader
out float localY; 

void main(){

    gl_Position.xyz = vertexPos;
    gl_Position.w = 1.0;

	// Apply the transform on the gl_Position => final position of each vertex
	gl_Position = transform * gl_Position;

    // 2. ADDED: Capture the Y coordinate before the shader finishes
    localY = vertexPos.y;
}